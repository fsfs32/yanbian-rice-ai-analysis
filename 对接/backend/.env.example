# ============================================================
# 环境变量模板：复制本文件为 .env 并填入真实值
# 严禁把 .env 提交到代码仓库
# ============================================================

# ---- 服务 ----
APP_ENV=development
DEBUG=true

# ---- CORS（多个来源用英文逗号分隔）----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- LLM（OpenAI 兼容协议）----
# 可替换为 DeepSeek / Moonshot / 通义千问等兼容端点
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=2
