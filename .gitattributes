# 统一行尾：文本文件入库统一为 LF，Windows 脚本落盘保持 CRLF
* text=auto

*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
*.vbs  text eol=crlf

*.sh   text eol=lf

# 二进制文件：不做行尾转换，也不参与文本 diff
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.docx  binary
*.xlsx  binary
*.zip   binary
*.woff  binary
*.woff2 binary
